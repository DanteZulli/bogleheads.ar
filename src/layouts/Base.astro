---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  // Use the title verbatim (home page). Otherwise "| site name" is appended.
  exactTitle?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  exactTitle = false,
  ogType = "website",
  ogImage = "https://bogleheads.ar/marca/og-card.png",
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const siteName = "Bogleheads® Argentina (no oficial)";
const fullTitle = exactTitle ? title : `${title} | ${siteName}`;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://bogleheads.ar",
).toString();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Dante Zulli" />
    <meta name="theme-color" content="#001f3f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bogleheads® Argentina" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Bogleheads® Argentina — Faro San Juan de Salvamento"
    />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <SiteHeader />
    <div class="unofficial-banner">
      Sitio no oficial, con fines educativos. No es asesoramiento financiero.{" "}
      <a href="/acerca/">Más info</a>.
    </div>
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
