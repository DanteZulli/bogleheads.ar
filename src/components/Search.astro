---
// Static search powered by Pagefind: it indexes dist/ after `npm run build`
// and serves results with zero backend. The /pagefind/* assets only exist
// post-build, so search works in preview/production, not in `npm run dev`.
---

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<div id="search"></div>
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    const ui = (window as any).PagefindUI;
    if (ui) {
      new ui({ element: "#search", showSubResults: true });
    }
  });
</script>
