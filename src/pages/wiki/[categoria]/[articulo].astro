---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import {
  basenameOf,
  categorySlug,
  categoryUrl,
  getAuthors,
  resolveUpdated,
} from "../../../lib/wiki";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  return entries.map((entry) => ({
    params: {
      categoria: categorySlug(entry.data.category),
      articulo: basenameOf(entry.id),
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const toc = headings.filter((heading) => heading.depth <= 3);

const formatDate = (value: Date) =>
  value.toLocaleDateString("es-AR", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

const published = formatDate(entry.data.date);
const updatedDate = resolveUpdated(
  entry.id,
  entry.data.date,
  entry.data.updated,
);
const revised = formatDate(updatedDate);
const authors = getAuthors(entry.data);

const toISO = (value: Date) => value.toISOString().split("T")[0];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: "es-AR",
  author: authors.map((name) => ({ "@type": "Person", name })),
  datePublished: toISO(entry.data.date),
  dateModified: toISO(updatedDate),
};
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedTime={toISO(entry.data.date)}
  modifiedTime={toISO(updatedDate)}
  jsonLd={jsonLd}
>
  <nav class="breadcrumbs" aria-label="Migas de pan">
    <span>Estás acá:</span>
    <ol>
      <li>
        <a href="/wiki/">Todos los temas</a>
      </li>
      <li>
        <a href={categoryUrl(entry.data.category)}>{entry.data.category}</a>
      </li>
      <li aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <article>
    <h1>{entry.data.title}</h1>
    <p class="article-meta">
      Por{" "}
      {authors.map((name, index) => (
        <>
          {index > 0 && <>, </>}
          <span>{name}</span>
        </>
      ))}
      {" "}· Publicado: {published} · Actualizado: {revised}
    </p>
    <div class="article-layout">
      <div class="article-body">
        <Content />
      </div>
      {
        toc.length > 0 && (
          <aside class="toc" aria-label="Contenido del artículo">
            <h2>En esta página</h2>
            <ol>
              {toc.map((heading) => (
                <li class={`toc-depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>
</Base>
