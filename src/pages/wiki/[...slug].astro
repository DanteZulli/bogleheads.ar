---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatDate = (value?: Date) =>
  value
    ? value.toLocaleDateString("es-AR", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      })
    : undefined;

const published = formatDate(entry.data.date);
const revised = formatDate(entry.data.updated);

const toISO = (value?: Date) => value?.toISOString().split("T")[0];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: "es-AR",
  author: { "@type": "Person", name: "Dante Zulli" },
  ...(entry.data.date && { datePublished: toISO(entry.data.date) }),
  ...(entry.data.updated && { dateModified: toISO(entry.data.updated) }),
};
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  publishedTime={toISO(entry.data.date)}
  modifiedTime={toISO(entry.data.updated)}
  jsonLd={jsonLd}
>
  <article>
    <h1>{entry.data.title}</h1>
    {
      (published || revised) && (
        <p class="article-meta">
          {published && <>Publicado: {published}</>}
          {published && revised && <> · </>}
          {revised && <>Actualizado: {revised}</>}
        </p>
      )
    }
    <Content />
  </article>
</Base>
