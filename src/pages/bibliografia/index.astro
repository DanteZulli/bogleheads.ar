---
import Base from "../../layouts/Base.astro";

interface Book {
  title: string;
  author: string;
  // Optional cover image. Drop the file into public/libros/ and reference
  // it here, e.g. cover: "/libros/guia-boglehead-de-inversion.jpg".
  cover?: string;
  // Optional link to a free ebook version.
  ebookUrl?: string;
}

const books: Book[] = [
  {
    title: "La guía Boglehead de inversión",
    author: "Mel Lindauer, Taylor Larimore y Michael LeBoeuf",
    cover: "/libros/la-guia-boglehead-de-inversion-deusto.jpg",
  },
  {
    title: "La guía Bogleheads España",
    author: "Bogleheads España",
    cover: "/libros/guia-bogleheads-es.jpg",
    ebookUrl: "https://bogleheads.es/guia",
  },
];
---

<Base
  title="Bibliografía recomendada"
  description="Libros recomendados sobre inversión pasiva y finanzas personales."
>
  <h1>Bibliografía recomendada</h1>
  <p>Lecturas para profundizar en la filosofía y su evidencia.</p>

  <ul class="book-grid">
    {
      books.map((book) => (
        <li class="book-card">
          <div class="book-top">
            {book.cover ? (
              <img
                class="book-cover"
                src={book.cover}
                alt={`Portada de ${book.title}`}
                loading="lazy"
              />
            ) : (
              <div class="book-cover-placeholder" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V2H6.5A2.5 2.5 0 0 0 4 4.5z" />
                  <path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" />
                </svg>
              </div>
            )}
            <div>
              <h3>
                {book.ebookUrl ? (
                  <a href={book.ebookUrl}>{book.title}</a>
                ) : (
                  book.title
                )}
              </h3>
              <p class="book-author">
                <em>{book.author}</em>
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Base>
