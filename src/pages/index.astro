---
import Base from "../layouts/Base.astro";
---

<Base
  title="Bogleheads® Argentina"
  description="Comunidad no oficial sobre la filosofía de inversión Bogleheads desde Argentina: inversión pasiva, indexada y periódica."
  exactTitle
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Bogleheads® Argentina",
    url: "https://bogleheads.ar/",
    description:
      "Comunidad no oficial sobre la filosofía de inversión Bogleheads desde Argentina.",
    inLanguage: "es-AR",
  }}
>
  <section class="hero">
    <img
      src="/favicon.svg"
      alt="Logo de Bogleheads Argentina"
      width="220"
      height="220"
    />
    <h1>Bienvenidos a Bogleheads® Argentina</h1>
    <p>
      <strong>
        Comunidad de inversión sobre la filosofía Bogleheads®: inversión
        pasiva, indexada y periódica, pensada desde Argentina.
      </strong>
    </p>
    <p><em>Stay the course.</em></p>
    <ul class="button-grid">
      <li><a class="button" href="/wiki/">Wiki</a></li>
      <li><a class="button secondary" href="/bibliografia/">Libros</a></li>
    </ul>
  </section>

  <section>
    <h2>Empezá por acá</h2>
    <ul class="card-grid">
      <li class="card">
        <a href="/wiki/filosofia-bogleheads/">
          <h3>Filosofía Bogleheads®</h3>
          <p>Los principios: vivir por debajo de tus medios, diversificar,
            minimizar costos y mantener el rumbo.</p>
        </a>
      </li>
      <li class="card">
        <a href="/wiki/importancia-de-ahorrar-temprano/">
          <h3>La importancia de empezar temprano</h3>
          <p>El interés compuesto premia al que empieza antes, no al que
            aporta más.</p>
        </a>
      </li>
      <li class="card">
        <a href="/wiki/invertir-desde-argentina/">
          <h3>Invertir desde Argentina</h3>
          <p>Moneda, inflación, instrumentos disponibles y fiscalidad local.</p>
        </a>
      </li>
    </ul>
  </section>
</Base>
